# --- Test Automation Dashboard — server configuration ---------------------------
# Copy to .env for local development (the dev server loads it automatically;
# production reads real environment variables only).

NODE_ENV=development
PORT=3000
# Ignored (forced to 127.0.0.1) while DASHBOARD_TOKEN is unset, so an
# auth-disabled server is never reachable from the network.
HOST=0.0.0.0
# SQLite file lives at $DATA_DIR/dashboard.db
DATA_DIR=./data
LOG_LEVEL=info

# --- Auth -----------------------------------------------------------------------------
# Shared editor token (>= 32 chars). Unset in dev = auth DISABLED (loud warning,
# loopback only, localhost Host headers only). REQUIRED in production.
# Use random values: openssl rand -hex 32
DASHBOARD_TOKEN=
# Optional read-only token for the management Report (>= 32 chars, must differ).
VIEWER_TOKEN=
# HMAC key for session cookies (>= 32 chars). REQUIRED in production.
SESSION_SECRET=
# Session lifetime, max 720 (30 days). Sessions are stateless: to revoke all of
# them, rotate SESSION_SECRET (or the token they were issued for).
SESSION_TTL_HOURS=168
# The URL users open, e.g. https://qa.example.com. Recommended behind a TLS proxy:
# it is the server's own origin for the CSRF check, makes the cookie Secure when
# https, and is added to the Host allowlist (which is then enforced).
PUBLIC_URL=
# Extra accepted Host header values (comma list, host[:port]). When this or
# PUBLIC_URL is set, requests with other Host headers are rejected (DNS rebinding).
ALLOWED_HOSTS=
# Extra origins allowed for cookie-authenticated writes / CORS (comma list).
# In development http://localhost:5173 (Vite) is always allowed.
ALLOWED_ORIGINS=
# Reverse proxy trust for X-Forwarded-* (client IP for rate limits, protocol):
#   false (default) | number of proxy hops, e.g. 1 | comma list of proxy IPs/CIDRs,
#   e.g. 10.0.0.0/8,127.0.0.1.  `true` is rejected: it lets clients spoof their IP.
TRUST_PROXY=false
# Built SPA served in production (default: apps/web/dist).
WEB_DIST=

# --- GitHub (optional) — PR links for automation work --------------------------------
# Full setup guide: docs/INTEGRATIONS.md
# Personal access token. Recommended: a *fine-grained* token (github.com → Settings →
# Developer settings → Fine-grained tokens) limited to the repos below, READ-ONLY:
#   Repository permissions: "Pull requests: Read", "Contents: Read", "Metadata: Read"
#   (+ "Commit statuses: Read" and, if offered, "Checks: Read" so CI status is shown).
# A classic token needs the "repo" scope for private repos (none for public ones).
GITHUB_TOKEN=
# Comma-separated owner/name list (required to enable the integration), e.g. acme/api,acme/web
GITHUB_REPOS=
# REST API base URL. Leave as is for github.com. GitHub Enterprise Server:
# https://github.yourcompany.com/api/v3 (GraphQL is then used at /api/graphql).
GITHUB_API_URL=https://api.github.com
# Optional automatic sync every N minutes (empty = only when "Sync now" is clicked / the API is called).
GITHUB_SYNC_INTERVAL_MINUTES=
# Which changed files count as tests (used for diff-based linking). Comma-separated globs.
GITHUB_TEST_PATH_GLOBS=**/test_*.py,**/*_test.py,**/tests/**

# --- Jira / Xray (optional) — test cases + bug status from Jira --------------------------
# Full setup guide (incl. how to tell Cloud from Server/Data Center): docs/INTEGRATIONS.md
# Your Jira address, https only, no trailing path. Cloud: https://yourcompany.atlassian.net
JIRA_BASE_URL=
# Jira CLOUD: your Atlassian account e-mail + an API token created at
#   https://id.atlassian.com → Security → API tokens → "Create API token".
JIRA_EMAIL=
JIRA_API_TOKEN=
# Jira SERVER / DATA CENTER only (instead of e-mail + API token): a Personal Access Token
#   (Jira → your avatar → Profile → Personal Access Tokens). Sent as a Bearer token.
JIRA_PAT=
# Which issues are your test cases (JQL). Example: project = QA AND issuetype = Test ORDER BY key
JIRA_JQL=issuetype = Test ORDER BY key
# Optional: id of a custom field holding "automated / manual / in progress …", e.g. customfield_10123
# (values are interpreted like the spreadsheet import's status column).
JIRA_AUTOMATION_FIELD=
# Optional, Xray CLOUD only: reads each Test's type (Manual / Cucumber / Generic) to mark
# Cucumber/Generic tests as automated. Create at Jira → Apps → Xray → Settings → API Keys.
# Not needed for anything else — the Jira token alone is enough to sync tests and bugs.
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
# Xray Cloud region (data residency). Default: global https://xray.cloud.getxray.app.
# Must be https and xray.cloud.getxray.app or a subdomain, e.g. https://eu.xray.cloud.getxray.app
# (no path — /api/v2 is appended).
XRAY_BASE_URL=
# Optional automatic sync every N minutes.
JIRA_SYNC_INTERVAL_MINUTES=
