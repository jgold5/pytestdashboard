{
  "name": "pytestdashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm --filter @ptd/server dev\" \"pnpm --filter @ptd/web dev\"",
    "build": "pnpm --filter @ptd/web build && pnpm --filter @ptd/server build",
    "start": "pnpm --filter @ptd/server start",
    "seed": "pnpm --filter @ptd/server seed",
    "reset-data": "pnpm --filter @ptd/server reset-data",
    "verify-counts": "python3 tools/verify_counts/compare.py",
    "share-examples": "python3 tools/verify_counts/share.py --examples",
    "typecheck": "pnpm -r typecheck && tsc -p e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
