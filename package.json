{
  "name": "pytestdashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm --filter @ptd/server dev\" \"pnpm --filter @ptd/web dev\"",
    "build": "pnpm --filter @ptd/web build && pnpm --filter @ptd/server build",
    "start": "pnpm --filter @ptd/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
